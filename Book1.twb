      <column caption='Borough (taxi zone lookup.csv1)' datatype='string' name='[Borough (taxi_zone_lookup.csv1)]' role='dimension' type='nominal' />
      <column caption='trip time ' datatype='integer' name='[Calculation_0707043688255488]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='datediff(&apos;minute&apos;,[lpep_dropoff_datetime],[lpep_pickup_datetime])' />
      </column>
      <column caption='TIME OF DAY' datatype='string' name='[Calculation_0707043696500738]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATEPART(&apos;hour&apos;,[lpep_pickup_datetime])&gt;=4 AND DATEPART(&apos;hour&apos;,[lpep_pickup_datetime])&lt;=10&#13;&#10;   THEN &quot;MORNING&quot;&#13;&#10;ELSEIF DATEPART(&apos;hour&apos;,[lpep_pickup_datetime])&gt;=11 AND DATEPART(&apos;hour&apos;,[lpep_pickup_datetime])&lt;=16&#13;&#10;   THEN &quot;AFTERNOON&quot;&#13;&#10;ELSEIF DATEPART(&apos;hour&apos;,[lpep_pickup_datetime])&gt;=17 AND DATEPART(&apos;hour&apos;,[lpep_pickup_datetime])&lt;=21&#13;&#10;   THEN &quot;EVENING&quot;&#13;&#10;ELSE &quot;LATE NIGHT&quot;&#13;&#10;END' />
      </column>
      <column caption='TOP 5 PARAMETERS' datatype='real' name='[Calculation_1324144941891589]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1324144940490752]&#13;&#10;WHEN &quot;AVERAGE REVENUE&quot; THEN AVG ([total_amount])&#13;&#10;WHEN &quot;AVERAGE TIP AMOUNT&quot; THEN AVG ([tip_amount])&#13;&#10;END' />
      </column>
